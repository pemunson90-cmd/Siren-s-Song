{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push --prune *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh release delete *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --delete *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.fable/FABLE_RUN.md)",
      "Edit(/.fable/TARGET.md)",
      "Edit(/scripts/toolchain/signing/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Python314\\python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_check.py"
            ]
          }
        ]
      }
    ]
  }
}
