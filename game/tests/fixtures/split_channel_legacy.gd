extends RefCounted
# Immutable fresh Split Channel snapshot generated by production simulation
# e877e79044120792b2b84bc195e4ec027887001a. No user profile/progression included.
static func simulation(upgrade:String="disruption"):
 var sim=preload("res://src/simulation/simulation.gd").new()
 var file=FileAccess.open("res://tests/fixtures/split_channel_legacy.bin",FileAccess.READ)
 var state=file.get_var();file.close()
 if upgrade=="disruption":state.tools.emp+=1
 if upgrade=="endurance":state.oxygen=120.0
 assert(sim.restore(state))
 return sim
