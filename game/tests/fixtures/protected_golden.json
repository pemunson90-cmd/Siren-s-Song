  {"rule": "silent sight 180 m, cruise sight 290 m (lock target and threat scan)", "file": "res://src/simulation/simulation.gd", "pattern": "\\(([0-9.]+) if \\w+\\.silent else ([0-9.]+)\\)\\*HuntPressure","values": ["180.0", "290.0", "180.0", "290.0"]},
  {"rule": "silent sight 180 m, cruise sight 290 m (industrial roles)", "file": "res://src/simulation/industrial_threats.gd", "pattern": "\\(([0-9.]+) if \\w+\\.silent else ([0-9.]+)\\)", "values": ["180.", "290."]},
  {"rule": "recipient sight", "file": "res://src/simulation/simulation.gd", "pattern": "recipient\\.pos\\)<([0-9.]+)\\*HuntPressure", "values": ["180."]},
  {"rule": "lock warning 4 s (mode)", "file": "res://src/simulation/simulation.gd", "pattern": "s\\.mode=\"LOCKING\" if s\\.lock<([0-9.]+) else \"BEAM\"", "values": ["4"]},
  {"rule": "lock warning 4 s (fire)", "file": "res://src/simulation/simulation.gd", "pattern": "if s\\.lock>=([0-9.]+):\\s+if previous_lock<([0-9.]+):", "values": ["4", "4"]},
  {"rule": "lock warning 4 s (received cue)", "file": "res://src/presentation/lock_warning.gd", "pattern": "c\\.lock>=([0-9.]+):continue[\\s\\S]*\"progress\":c\\.lock/([0-9.]+),\"remaining\":([0-9.]+)-c\\.lock", "values": ["4", "4.", "4."]},
  {"rule": "lock interruptible: decays when sight breaks", "file": "res://src/simulation/simulation.gd", "pattern": "s\\.target=-1; s\\.lock=maxf\\(0,s\\.lock-dt\\*([0-9.]+)\\)", "values": ["3"]},
  {"rule": "lock interruptible: resets on new target", "file": "res://src/simulation/simulation.gd", "pattern": "if s\\.target!=detected or [^:\\n]*:(s\\.lock=0\\.0)", "values": ["s.lock=0.0"]},
  {"rule": "lock interruptible: resets on stun", "file": "res://src/simulation/simulation.gd", "pattern": "s\\.stun-=dt; (s\\.lock=0\\.0)", "values": ["s.lock=0.0"]},
  {"rule": "beam one-shot kill (Quietus)", "file": "res://src/simulation/simulation.gd", "pattern": "elif detected==0: (hull=0\\.0); outcome=\"(\\w+)\";(vaporized=true)", "values": ["hull=0.0", "lost", "vaporized=true"]},
  {"rule": "beam one-shot kill (drone)", "file": "res://src/simulation/simulation.gd", "pattern": "else: (units\\[detected\\]\\.alive=false); s\\.lock=0", "values": ["units[detected].alive=false"]},
  {"rule": "collision damage formula", "file": "res://src/simulation/simulation.gd", "pattern": "return (clampf\\(\\(impact-COLLISION_SAFE_SPEED\\)\\*COLLISION_DAMAGE_PER_SPEED,0\\.0,COLLISION_MAX_DAMAGE\\))", "values": ["clampf((impact-COLLISION_SAFE_SPEED)*COLLISION_DAMAGE_PER_SPEED,0.0,COLLISION_MAX_DAMAGE)"]},
  {"rule": "hearing (legacy propulsion)", "file": "res://src/simulation/simulation.gd", "pattern": "propulsion_speed\\(u\\)>([0-9.]+) and dist<([0-9.]+)\\*Recon", "values": ["50", "430"]},
  {"rule": "ending fork records", "file": "res://src/campaign/endings.gd", "pattern": "route==\"concealed\" and (\\d+) in done\\) or \\(route==\"overt\" and (\\d+) in done", "values": ["12", "13"]},
  {"rule": "ending final op", "file": "res://src/campaign/endings.gd", "pattern": "if (\\d+) not in progress\\.get\\(\"completed\"", "values": ["34"]},
  {"rule": "ending table", "file": "res://src/campaign/endings.gd", "pattern": "if route==\"(\\w+)\":id=\"(\\w+)\" if thread==\"(\\w+)\" else \"(\\w+)\" if thread==\"(\\w+)\"", "values": ["concealed", "silent_exodus", "deep", "hidden_harbour", "shelf", "overt", "beacon_pact", "deep", "surface_reckoning", "shelf"]},
  {"rule": "ending late channel majority", "file": "res://src/campaign/endings.gd", "pattern": "votes\\[channel\\]>=(\\d+) and", "values": ["2"]}
