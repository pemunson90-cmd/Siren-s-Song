extends SceneTree
const G=preload("res://src/input/map_gesture.gd")
var checks=0
var failures=0
func check(ok,label):
 checks+=1
 if not ok:failures+=1;printerr("FAIL ",label)
func _initialize():call_deferred("run")
func run():
 var g=G.new()
 check(not g.active() and g.feed("move",0,Vector2.ONE).is_empty() and g.feed("release",0,Vector2.ONE).is_empty(),"idle gesture ignores moves and releases of unknown touches")
 g.feed("press",0,Vector2(100,100))
 check(g.active(),"press makes the gesture active")
 check(g.feed("press",0,Vector2(900,900)).is_empty() and g.origin==Vector2(100,100),"a duplicate press index is ignored")
 var r=g.feed("release",0,Vector2(105,100))
 check(r=={"tap":Vector2(105,100)} and not g.active(),"release within threshold is a tap and clears state")
 g.feed("press",0,Vector2.ZERO)
 check(g.feed("release",0,Vector2(G.DRAG_THRESHOLD,0)).has("tap"),"distance equal to the threshold is a tap")
 g.feed("press",0,Vector2.ZERO)
 var past=g.feed("release",0,Vector2(G.DRAG_THRESHOLD+0.5,0))
 check(past=={"ended":true,"navigation":false},"release just past the threshold without a drag move is neither tap nor navigation")
 g.feed("press",0,Vector2.ZERO)
 check(g.feed("move",0,Vector2(10,0)).is_empty() and not g.dragged,"small movement under the threshold is not a pan")
 var pan=g.feed("move",0,Vector2(30,0))
 check(g.dragged and pan=={"pan":Vector2(20,0)},"crossing the threshold starts panning with the incremental delta")
 check(g.feed("move",0,Vector2(35,5))=={"pan":Vector2(5,5)},"later moves keep panning incrementally")
 var done=g.feed("release",0,Vector2(35,5))
 check(done=={"ended":true,"navigation":true} and not g.active() and not g.dragged,"releasing a drag reports navigation and resets")
 g.feed("press",0,Vector2(0,0))
 var second=g.feed("press",1,Vector2(100,0))
 check(second.is_empty() and g.was_multi and g.dragged,"a second finger marks the gesture multi-touch and dragged")
 var z=g.feed("move",1,Vector2(200,0))
 check(is_equal_approx(z.zoom,2.0) and z.anchor==Vector2(50,0) and z.pan==Vector2(50,0),"spreading fingers reports zoom 2 around the old midpoint")
 var pinch=g.feed("move",1,Vector2(100,0))
 check(is_equal_approx(pinch.zoom,0.5),"pinching back halves the distance")
 check(g.feed("release",1,Vector2(100,0)).is_empty() and g.active(),"lifting one of two fingers keeps the gesture alive")
 check(g.feed("release",0,Vector2(0,0))=={"ended":true,"navigation":true},"multi-touch always ends as navigation, never a tap")
 g.feed("press",0,Vector2(5,5))
 g.feed("press",1,Vector2(5,5))
 var zz=g.feed("move",1,Vector2(15,5))
 check(is_finite(zz.zoom) and zz.zoom>0.0,"coincident fingers give a finite zoom")
 g.cancel()
 check(not g.active() and not g.dragged and not g.was_multi,"cancel clears every flag")
 g.feed("press",0,Vector2.ZERO)
 check(g.feed("hover",0,Vector2(50,50)).is_empty(),"unknown event kinds are ignored")
 g.cancel()
 g.feed("press",0,Vector2.ZERO)
 g.feed("press",1,Vector2(10,0))
 g.feed("press",2,Vector2(0,10))
 check(g.feed("move",2,Vector2(0,50)).is_empty(),"a third touch does not drive zoom")
 print("MAP GESTURE CHECKS %d FAILURES %d"%[checks,failures])
 quit(1 if failures>0 else 0)
