extends SceneTree
# Staged outcomes verify mode/save isolation; operation gameplay is inherited.
const State=preload("res://src/campaign/runs/run_state.gd")
const Archive=preload("res://src/campaign/runs/run_archive.gd")
const Modes=preload("res://src/presentation/runs/modes_frontend.gd")
var checks=0
var failures=0
func check(ok,label):
	checks+=1
	if not ok:failures+=1;printerr("FAIL ",label)
func _initialize():call_deferred("run")
func settle():
	for n in 4:await process_frame
func run():
	var path="user://expedition-session.save"
	for file in [path,path+".runs"]:
		for suffix in ["",".bak",".tmp"]:DirAccess.remove_absolute(file+suffix)
	var host=load("res://scenes/main.tscn").instantiate()
	host.capture_scenario="runtime-test";host.store.path=path;root.add_child(host);await settle()
	host.economy=preload("res://src/campaign/economy.gd").new_state("standard",true)
	host._show_campaign();host._save_archive()
	var before=FileAccess.get_file_as_bytes(path);var snapshot=host.sim.snapshot()
	var front=load("res://src/presentation/frontend/frontend.gd").new()
	host.add_child(front);front.setup(host,true);front._mode_select();await settle()
	check(front.screen=="modes","Start has a separate mode selector")
	var career=front.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_action","")=="mode_career")
	check(career.size()==1 and career[0].disabled,"Career is visibly unavailable until057")
	check(Archive.persist(host,State.new_run(12345)),"seeded run writes only its sidecar")
	Modes.start(front);await settle()
	var session=host.get_node_or_null("ExpeditionSession")
	check(session!=null and session.screen=="expedition_menu" and not session.active_started,"expedition previews without committing a launch")
	if session!=null:
		session._begin();await settle()
		check(session.active_started and session.sim.paused and session.run_state.in_flight,"launch commits before entering paused physical simulation")
		check(host.process_mode==Node.PROCESS_MODE_DISABLED,"campaign stays frozen during expedition")
		host.store.suspended=true
		session.sim.outcome="won";session._debrief();await settle()
		check(session.run_state.cursor==1 and session.run_state.status=="active","successful recovery advances exactly one operation")
		var recovered=session.run_state.duplicate(true)
		var retry=session.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_action","")=="run_retry_save")
		check(retry.size()==1 and session.recorded,"failed result save offers retry while retaining the recorded result")
		host.store.suspended=false
		if retry.size()==1:retry[0].emit_signal("pressed")
		await settle()
		check(session.run_state==recovered and Archive.restore(host)==recovered,"retry saves the same recovered ledger without settling twice")
		var result_back=InputEventKey.new();result_back.pressed=true;result_back.keycode=KEY_ESCAPE;session._unhandled_key_input(result_back);await settle()
		check(session.screen=="expedition_result" and session.recorded and session.run_state==recovered,"Back preserves the completed result until explicit advance")
		var next=session.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_action","")=="run_next")
		check(next.size()==1,"saved recovery offers NEXT OPERATION")
		if next.size()==1:next[0].emit_signal("pressed")
		await settle()
		check(session.screen=="expedition_offers" and session.run_state==recovered,"NEXT exposes saved between-operation offers")
		session._pick_offer("refit");await settle()
		recovered=session.RunOffers.choose(recovered,"refit")
		var begin=session.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_action","")=="run_begin")
		check(session.screen=="expedition_menu" and not session.recorded and not session.active_started and begin.size()==1,"NEXT clears the completed marker and exposes BEGIN for the next operation")
		check(session.run_state==recovered and session.sim.mission.id==State.current_operation(recovered),"NEXT prepares the next operation while preserving recovered progress and supplies")
		if begin.size()==1:begin[0].emit_signal("pressed")
		await settle()
		var launched=State.launch(recovered)
		check(session.screen=="mission" and session.active_started and session.sim.paused and not session.recorded and session.run_state==launched and Archive.restore(host)==launched,"BEGIN commits only the next launch and enters its paused simulation")
		session.sim.outcome="won";session._debrief();await settle()
		check(session.recorded and session.run_state.cursor==2 and session.run_state.results.size()==2 and State.valid(session.run_state),"the next operation records its own recovery exactly once")
		session._return();await settle()
	check(host.sim.snapshot()==snapshot and FileAccess.get_file_as_bytes(path)==before,"run outcome preserves Ironman campaign simulation and archive bytes")
	check(Archive.restore(host).cursor==2,"between-operation state survives return")
	Modes.start(front);await settle();session=host.get_node_or_null("ExpeditionSession")
	if session!=null:
		if session.RunOffers.pending(session.run_state):session._pick_offer("refit");await settle()
		session._begin();await settle()
		var to_menu=InputEventKey.new();to_menu.pressed=true;to_menu.keycode=KEY_ESCAPE;session._unhandled_key_input(to_menu);await settle()
		var abandon=session.find_children("*","Button",true,false).filter(func(b):return b.get_meta("ui_action","")=="run_abandon")
		check(abandon.size()==1,"active dive exposes its explicit end-dive action")
		if abandon.size()==1:abandon[0].emit_signal("pressed")
		await settle()
		check(session.run_state.status=="lost" and session.recorded and session.screen=="expedition_result","ending an active dive settles and records a terminal loss")
		var lost=session.run_state.duplicate(true)
		var escape=InputEventKey.new();escape.pressed=true;escape.keycode=KEY_ESCAPE;session._unhandled_key_input(escape);await settle()
		check(session.screen=="expedition_result" and session.find_children("*","Button",true,false).all(func(b):return b.get_meta("ui_action","")!="run_resume"),"Escape after abandonment restores the terminal result instead of reopening RESUME DIVE")
		check(session.run_state==lost and Archive.restore(host)==lost and session.find_children("*","Button",true,false).all(func(b):return b.get_meta("ui_action","") not in ["run_begin","run_next"]),"Back preserves the terminal ledger and offers no new launch or advance")
		session._return();await settle()
	check(Archive.restore(host).status=="lost" and FileAccess.get_file_as_bytes(path)==before,"loss persists outside campaign SAVE2 timeline")
	var save2=preload("res://src/persistence/save_states/save2_controller.gd")
	check(save2.locked(host),"mode return preserves079 Ironman hard-save guard")
	host.queue_free();await settle()
	print("EXPEDITION SESSION CHECKS ",checks," FAILURES ",failures);quit(1 if failures else 0)
