static func rows(op:int,active:bool=true)->Array:
 if not enabled or not active:return []
 var result=[]
 for n in TABLE.get(op,[]).size():
  var t=TABLE[op][n]
  result.append({"id":"landmark_%d_%d"%[op,n],"source":"rock","band":t[0],"rock":t[1],"polygon":PackedVector2Array(t[2]),"style":t[3],"glow":t[4],"edge":t[5],"at":t[6],"color":palette(op)})
 for photo in PHOTOS.CAMPAIGN_PHOTOS:
  if photo.op==op:
   result.append({"id":"landmark_"+photo.key,"source":"subject","key":photo.key,"band":photo.band,"style":"lamp","glow":.35,"color":palette(op)})
 if op in LOAD_OPS:result.append({"id":"landmark_sled_%d"%op,"source":"load","band":1,"style":"lamp","glow":.35,"color":palette(op)})
 return result
static func palette(op:int)->Color:
 return Color("8cdcd3") if op<14 else (Color("78bfd9") if op<22 else Color("e0bf83"))
