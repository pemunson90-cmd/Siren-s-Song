  SUSP_MAX: 100,
  SUSP_PING_COST: 25,
  SUSP_DECAY_PER_SEC: 5,
  THRESH_ALERT: 34,
  THRESH_HOSTILE: 75,
  WARNING_THRESHOLD: 75,
  INSTAKILL_SUSTAIN_SEC: 4.0,

