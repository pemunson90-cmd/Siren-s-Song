<script>
"use strict";

/* =========================================================================
 *  SIREN'S SONG -- Step 4 build (Sentinel + Hunter Siren types +
 *  curiosity/decoy behavior + Siren-near-sub scaling suspicion) on top
 *  of Step 3 (drones + sub cam + factory + photo objectives + factory
 *  proximity suspicion + extraction + win/lose) + Step 1 FIX-PASS
