  SENTINEL_ORBIT_CENTER_X: 855,         // matches power_core position
  SENTINEL_ORBIT_CENTER_Y: 410,
  SENTINEL_ORBIT_RADIUS_PX: 40,         // FLAG step 7 -- small orbit, not stationary
  SENTINEL_ORBIT_SPEED_RAD_PER_SEC: 0.45, // FLAG step 7 -- one orbit in ~14s
  SENTINEL_DETECT_RADIUS_PX: 220,       // FLAG step 7 -- "large" per spec section 7
  SENTINEL_RADIUS_PX: 16,               // placeholder body, slightly larger than Patroller
  SENTINEL_RAM_HULL_DMG: 1,             // same as Patroller per brief
  SENTINEL_PROXIMITY_RANGE_PX: 240,     // Siren-near-sub term applies inside this
  SENTINEL_PROXIMITY_MAX_RATE: 2.0,     // FLAG step 7 -- max +/s contribution at touch
  SENTINEL_CURIOUS_SPEED_PX_PER_SEC: 24, // FLAG step 7 -- slow, non-lethal investigate
  SENTINEL_ALERT_SPEED_PX_PER_SEC: 55,  // FLAG step 7 -- pursuit/ram speed at Alert+
  SENTINEL_RETURN_TOLERANCE_PX: 30,     // resume orbit when within this of orbit ring

  // -- Hunter (spec section 7) --
  // Dormant below Alert (no movement). At Alert+ activates and actively
  // pursues last-known contact at speed visibly faster than Patroller.
  // The threat your own noise summons.
  HUNTER_DORMANT_X: 200,                // hand-authored dormant position (top-left area)
  HUNTER_DORMANT_Y: 60,
  HUNTER_RADIUS_PX: 12,                 // placeholder body
  HUNTER_PURSUE_SPEED_PX_PER_SEC: 90,   // FLAG step 7 -- fast; Patroller Alert+ is 64
  HUNTER_RAM_HULL_DMG: 1,               // same as Patroller per brief
  HUNTER_PROXIMITY_RANGE_PX: 200,
  HUNTER_PROXIMITY_MAX_RATE: 2.0,       // FLAG step 7
  HUNTER_CURIOUS_SPEED_PX_PER_SEC: 22,  // FLAG step 7 -- still moves at Curious to
                                        // investigate decoys (curiosity is cross-cutting)
  HUNTER_RETURN_ACTIVE: true,           // Hunter returns toward dormant position when
                                        // suspicion drops below Alert and no decoy of
                                        // interest in range (so the world re-settles)

  // -- Curiosity (cross-cutting, all 3 Siren types in Curious state) --
  // Spec section 7: "any Siren in Curious state will move to investigate
  // a decoy drone or a recent ping. Slow; non-lethal approach."
  CURIOSITY_REACH_PX: 35,               // "satisfied" radius for arriving at decoy/ping
  CURIOSITY_PING_RANGE_PX: 360,         // a Siren considers a recent ping if within this
  CURIOSITY_PASSIVE_DECOY_RANGE_PX: 180, // a parked drone draws Curious Sirens within this
  CURIOSITY_ACTIVE_DECOY_RANGE_PX: 320,  // a decoy-mode drone draws at larger range
  CURIOSITY_PATROLLER_SPEED_PX_PER_SEC: 28, // FLAG step 7 -- Patroller curiosity speed
                                            // (slightly slower than route base 40)

  // -- Decoy mode (drones) --
  // Per Pat 2026-06-03 ruling, BOTH passive (parked drone) AND active
  // (explicit decoy toggle) count. Active boosts draw range and weight.
  DECOY_ACTIVE_WEIGHT: 2.0,             // multiplier on attraction strength for
                                        // active decoys (vs. passive)
  DECOY_TOGGLE_KEY_HINT: "B",           // for HUD help (UI doc only)
};

/* ----- Terrain (unchanged from step 1; step 2 verified patroller route
 * clears these with the 14px patroller body). ------------------------- */
const TERRAIN = [
  { x:  80, y:  60, w: 140, h:  40 },
  { x: 760, y:  50, w: 160, h:  60 },
  { x:  40, y: 280, w:  60, h: 180 },
  { x: 860, y: 260, w:  70, h: 200 },
  { x: 120, y: 540, w: 200, h:  60 },
  { x: 640, y: 560, w: 240, h:  50 },
  { x: 260, y: 180, w: 120, h:  30 },
  { x: 500, y: 200, w:  40, h: 140 },
  { x: 360, y: 360, w: 180, h:  30 },
  { x: 620, y: 380, w:  90, h:  90 },
  { x: 220, y: 420, w:  90, h:  40 },
];

/* ----- Patroller route (unchanged from step 2) ----------------------- */
const PATROL_ROUTE = [
  { x: 200, y: 240 },
  { x: 200, y: 150 },
  { x: 440, y: 140 },
  { x: 600, y: 140 },
  { x: 720, y: 200 },
  { x: 780, y: 240 },
  { x: 780, y: 510 },
  { x: 480, y: 510 },
  { x: 200, y: 500 },
  { x: 160, y: 380 },
];

/* ----- Factory + objectives + extraction (hand-authored, no proc-gen)
 *
 * The factory sits on the right side of the play area, away from the
 * extraction point at the bottom-left. The sub starts mid-screen at
 * (480, 320). To run a full mission the player must traverse from
 * mid -> factory (escalating suspicion via factory proximity) -> back
 * across the play area to extraction. This matches spec section 8
 * "objectives spread across the site so suspicion escalates across a
 * route, and the return leg is the gauntlet."
 *
 * The factory itself is a placeholder rectangle (INV6). The three
 * required objective markers are placed: silhouette = outer field
 * (works from a wide arc), bays = upper-right inside the factory hull,
 * power core = lower-right interior (deeper exposure).
 * ------------------------------------------------------------------- */
const FACTORY = { x: 730, y: 240, w: 180, h: 200, cx: 820, cy: 340 };

const OBJECTIVES = [
  // id, name, x, y, required (true|false)
  // The silhouette point is anchored at the factory center -- it represents
  // "frame the whole structure" so the player can sub-cam it from distance.
  { id: "silhouette",   name: "factory silhouette", x: 820, y: 340, required: true,  captured: false },
  // Construction bays: top-edge of the factory hull (sub must approach near
  // factory top to drone-cam this, or close to point-blank with sub-cam).
  { id: "bays",         name: "construction bays",  x: 800, y: 260, required: true,  captured: false },
  // Power core: deep interior (lower portion of the factory).
  { id: "power_core",   name: "power core",         x: 855, y: 410, required: true,  captured: false },
];
const BONUS_OBJECTIVE = {
  id: "siren_closeup", name: "Siren close-up (bonus)", captured: false,
};

const EXTRACTION = { x: 70, y: 70, r: TUNING_PLACEHOLDER_UNUSED() };

// Patch the unused placeholder above -- the EXTRACTION radius is read from
// TUNING.EXTRACTION_RADIUS_PX. (This indirection avoids a forward-reference
// when TUNING is built; the placeholder call returns undefined and we
// overwrite below.)
function TUNING_PLACEHOLDER_UNUSED() { return undefined; }
EXTRACTION.r = TUNING.EXTRACTION_RADIUS_PX;

/* ----- State --------------------------------------------------------- */
let state;

function newState() {
  return {
    // step 1 (sub).
    // Step 1 fix-pass 2026-06-04: added angularVel for turn-rate inertia.
    // vx/vy are now persistent (carry across ticks; thrust accelerates,
    // drag decays). Previously they were derived per-tick from input.
    sub: { x: 480, y: 320, heading: 0, vx: 0, vy: 0, angularVel: 0 },
    hull: TUNING.HULL_MAX,
    oxygen: TUNING.OXYGEN_MAX_SECONDS,
    hullHitCooldown: 0,
    ping: { tStart: -Infinity, originX: 0, originY: 0 },
    loseReason: null,           // null | "sunk" | "suffocated" | "vaporized"
    winState: false,            // step 3 -- extracted with all required photos
    timeSec: 0,

    // step 2 -- suspicion
    suspicion: 0,
    lastSuspChange: 0,
    instakillTimer: 0,

    // step 2 -- Patroller
    patroller: {
      x: PATROL_ROUTE[0].x,
      y: PATROL_ROUTE[0].y,
      waypointIdx: 1,
      mode: "patrolling",
    },
    // step 4 -- Sentinel: orbits the power-core objective
    sentinel: {
      type: "sentinel",
      x: TUNING.SENTINEL_ORBIT_CENTER_X + TUNING.SENTINEL_ORBIT_RADIUS_PX,
      y: TUNING.SENTINEL_ORBIT_CENTER_Y,
      orbitAngle: 0,
      mode: "orbiting",  // orbiting | investigating | pursuing
    },
    // step 4 -- Hunter: dormant until Alert+; then pursues last-known contact
    hunter: {
      type: "hunter",
      x: TUNING.HUNTER_DORMANT_X,
      y: TUNING.HUNTER_DORMANT_Y,
      mode: "dormant",  // dormant | investigating | pursuing | returning
    },
    lastPing: { x: 0, y: 0, valid: false },

    // step 3 -- drones
    droneSupply: TUNING.DRONE_SUPPLY_INITIAL,
    drones: [],                 // {id, x, y, targetX, targetY, alive}
    nextDroneId: 1,
    selectedDroneId: null,      // for F-photo and TAB-cycle

    // step 3 -- objectives (deep-copy default state per run)
    objectives: OBJECTIVES.map(o => ({ ...o })),
    bonus: { ...BONUS_OBJECTIVE },
  };
}

/* ----- Input --------------------------------------------------------- */
const keys = new Set();
window.addEventListener("keydown", (e) => {
  keys.add(e.code);
  if (e.code === "Space") tryActivePing();
  if (e.code === "KeyR" && (state.loseReason || state.winState)) state = newState();
  if (e.code === "Tab") { cycleSelectedDrone(); e.preventDefault(); }
  if (e.code === "KeyF") tryDronePhoto();
  if (e.code === "KeyG") trySubCamPhoto();
  if (e.code === "KeyB") toggleDecoyOnSelected();  // step 4 -- decoy mode
  if (["ArrowUp","ArrowDown","ArrowLeft","ArrowRight","Space"].includes(e.code)) {
    e.preventDefault();
  }
});
window.addEventListener("keyup", (e) => keys.delete(e.code));

/* Mouse: left-click = deploy drone; right-click = redirect nearest drone. */
canvas.addEventListener("contextmenu", (e) => e.preventDefault());
canvas.addEventListener("mousedown", (e) => {
  if (state.loseReason || state.winState) return;
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  if (e.button === 0) {
    deployDrone(x, y);
  } else if (e.button === 2) {
    redirectNearestDrone(x, y);
  }
});

/* ----- Suspicion API (step 2 chokepoint, unchanged) ------------------ */
function applySuspicion(amount, sourceTag) {
  if (state.loseReason || state.winState) return 0;
  const before = state.suspicion;
  state.suspicion = clamp(state.suspicion + amount, TUNING.SUSP_MIN, TUNING.SUSP_MAX);
  state.lastSuspChange = state.suspicion - before;
  return state.lastSuspChange;
}

function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }

function suspicionState(s) {
  if (s >= TUNING.WARNING_THRESHOLD) return "WARNING";
  if (s >= TUNING.THRESH_ALERT)      return "ALERT";
  return "CURIOUS";
}
function isAlertPlus(s) { return s >= TUNING.THRESH_ALERT; }

/* ----- step 3 -- factory proximity suspicion gain rate (per second)
 * Spec section 6: "factory proximity +1 to +3/sec (scales with closeness)."
 * We treat the nearest edge of the factory rectangle as the distance
 * reference (so the player is "near" when the sub is hugging the wall,
 * not when the center of the factory is 0 px away -- the factory is large).
 * Returns a number in [0, 3] per second.
 * ------------------------------------------------------------------- */
function factoryProximityGainPerSec(subX, subY) {
  const d = distancePointToRect(subX, subY, FACTORY);
  if (d <= TUNING.FACTORY_PROX_NEAR_PX) return TUNING.FACTORY_PROX_NEAR_RATE;
  if (d <= TUNING.FACTORY_PROX_MID_PX)  return TUNING.FACTORY_PROX_MID_RATE;
  if (d <= TUNING.FACTORY_PROX_FAR_PX)  return TUNING.FACTORY_PROX_FAR_RATE;
  return 0;
}

function distancePointToRect(px, py, r) {
  const rx = Math.max(r.x, Math.min(px, r.x + r.w));
  const ry = Math.max(r.y, Math.min(py, r.y + r.h));
  const dx = px - rx, dy = py - ry;
  return Math.hypot(dx, dy);
}

/* ----- Active ping (step 2; unchanged) ------------------------------- */
function tryActivePing() {
  if (state.loseReason || state.winState) return;
  state.ping.tStart = state.timeSec;
  state.ping.originX = state.sub.x;
  state.ping.originY = state.sub.y;
  applySuspicion(TUNING.SUSP_PING_COST, "active_ping");
  state.lastPing.x = state.sub.x;
  state.lastPing.y = state.sub.y;
  state.lastPing.valid = true;
}

/* ----- step 3 -- Drone operations ---------------------------------- */
function deployDrone(x, y) {
  if (state.droneSupply <= 0) return null;
  // Refuse to deploy on terrain or out of bounds -- the brief calls
  // drone destruction "your call." Deploying directly into terrain
  // would destroy the drone instantly, which feels punitive for a
  // misclick. Deny the deploy instead and keep the supply.
  if (x < 0 || y < 0 || x > WORLD_W || y > WORLD_H) return null;
  if (anyTerrainHit(x, y, TUNING.DRONE_RADIUS_PX)) return null;

  // Spawn from the sub (torpedo tube launch per spec section 4) but
  // target the click destination. The drone walks there over time.
  const drone = {
    id: state.nextDroneId++,
    x: state.sub.x,
    y: state.sub.y,
    targetX: x,
    targetY: y,
    alive: true,
    decoyMode: false,  // step 4: toggled via B key. Passive (parked) draws
                       // Curious Sirens at PASSIVE_DECOY_RANGE; active (true)
                       // draws at ACTIVE_DECOY_RANGE with DECOY_ACTIVE_WEIGHT.
  };
  state.drones.push(drone);
  state.droneSupply -= 1;
  state.selectedDroneId = drone.id;
  return drone;
}

function redirectNearestDrone(x, y) {
  // Move the nearest alive drone to (x, y).
  let best = null, bestDist = Infinity;
  for (const d of state.drones) {
    if (!d.alive) continue;
    const dd = (d.x - x) * (d.x - x) + (d.y - y) * (d.y - y);
    if (dd < bestDist) { bestDist = dd; best = d; }
  }
  if (!best) return null;
  best.targetX = x;
  best.targetY = y;
  state.selectedDroneId = best.id;
  return best;
}

function cycleSelectedDrone() {
  const alive = state.drones.filter(d => d.alive);
  if (alive.length === 0) { state.selectedDroneId = null; return; }
  const idx = alive.findIndex(d => d.id === state.selectedDroneId);
  const next = alive[(idx + 1) % alive.length];
  state.selectedDroneId = next.id;
}

function getSelectedDrone() {
  if (state.selectedDroneId == null) return null;
  return state.drones.find(d => d.id === state.selectedDroneId && d.alive) || null;
}

/* ===================================================================
 * Step 4 -- Decoy + Siren common helpers
 * =================================================================== */

/* toggleDecoyOnSelected -- flip decoy mode on the currently selected
 * drone. Per Pat 2026-06-03 ruling: parked drones ALREADY act as bait
 * passively (any deployed drone within CURIOSITY_PASSIVE_DECOY_RANGE_PX
 * draws Curious Sirens). Active mode (this toggle) increases the draw
 * range and weight. Both routes are implemented; both are spec-legal.
 * The toggle gives the player intentional control without changing
 * the spec's "drones bait by being there" base behavior.
 * ------------------------------------------------------------------ */
function toggleDecoyOnSelected() {
  const d = getSelectedDrone();
  if (!d) return null;
  d.decoyMode = !d.decoyMode;
  return d;
}

/* allSirens -- single iterator over Patroller + Sentinel + Hunter.
 * Order doesn't matter (no priority encoded). Used by bonus photo,
 * suspicion proximity term, and any future Siren-iterating logic.
 * ------------------------------------------------------------------ */
function allSirens() {
  return [state.patroller, state.sentinel, state.hunter];
}

/* sirenProximityGainPerSec -- step 4 implementation of spec section 6
 * "Siren-near-sub +scaling/sec (closer = faster)". Sums each Siren's
 * contribution. Per-Siren contribution is linear from MAX_RATE (touch)
 * to 0 (at proximity range edge); a far Siren contributes 0.
 *
 * Patroller, Sentinel, Hunter each have their own PROXIMITY_RANGE_PX
 * and PROXIMITY_MAX_RATE so different types can be tuned independently
 * (Sentinel "you stepped into my zone" should plausibly outweigh
 * Patroller "I'm walking near you"). FLAG step 7 for tuning.
 * ------------------------------------------------------------------ */
function sirenProximityGainPerSec(subX, subY) {
  let total = 0;
  // Patroller term -- new for step 4 (was deferred since only 1 Siren existed).
  total += sirenProxTerm(subX, subY, state.patroller,
                         TUNING.PATROL_RADIUS_PX + 180,  // proximity range
                         1.5);                            // max rate
  total += sirenProxTerm(subX, subY, state.sentinel,
                         TUNING.SENTINEL_PROXIMITY_RANGE_PX,
                         TUNING.SENTINEL_PROXIMITY_MAX_RATE);
  total += sirenProxTerm(subX, subY, state.hunter,
                         TUNING.HUNTER_PROXIMITY_RANGE_PX,
                         TUNING.HUNTER_PROXIMITY_MAX_RATE);
  return total;
}

function sirenProxTerm(sx, sy, siren, range, maxRate) {
  const dx = siren.x - sx, dy = siren.y - sy;
  const d = Math.hypot(dx, dy);
  if (d >= range) return 0;
  // Linear ramp: at touch (d=0) -> maxRate; at edge (d=range) -> 0.
  return maxRate * (1 - d / range);
}

/* findCuriosityTarget -- for a given Siren in Curious state, return the
 * point it should investigate (decoy position or recent ping), or null
 * if nothing attractive is in scoring range. Active-mode decoys win
 * over passive at equal distance via DECOY_ACTIVE_WEIGHT.
 *
 * Scoring is "effective distance" = real distance / weight. Lower wins.
 * A passive parked drone within PASSIVE_DECOY_RANGE has weight 1.0;
 * an active-mode drone within ACTIVE_DECOY_RANGE has weight
 * DECOY_ACTIVE_WEIGHT. The last ping origin (if recent and within
 * CURIOSITY_PING_RANGE) competes too, with weight 1.0.
 *
 * LOS is not required for curiosity targets -- sirens supernaturally
 * sense pings/decoys per spec section 7 ("detection inputs ... no
 * hidden detection: if a Siren found you, a rule you can name did
 * it"). The rules ARE the proximity / decoy / ping criteria.
 * ------------------------------------------------------------------ */
function findCuriosityTarget(siren) {
  let bestPt = null;
  let bestScore = Infinity;

  for (const d of state.drones) {
    if (!d.alive) continue;
    const dist = Math.hypot(d.x - siren.x, d.y - siren.y);
    const range = d.decoyMode
      ? TUNING.CURIOSITY_ACTIVE_DECOY_RANGE_PX
      : TUNING.CURIOSITY_PASSIVE_DECOY_RANGE_PX;
    if (dist > range) continue;
    const weight = d.decoyMode ? TUNING.DECOY_ACTIVE_WEIGHT : 1.0;
    const score = dist / weight;
    if (score < bestScore) {
      bestScore = score;
      bestPt = { x: d.x, y: d.y, kind: d.decoyMode ? "active-decoy" : "passive-decoy" };
    }
  }

  // Last ping is a curiosity attractor too (spec section 7).
  if (state.lastPing.valid) {
    const dist = Math.hypot(state.lastPing.x - siren.x, state.lastPing.y - siren.y);
    if (dist <= TUNING.CURIOSITY_PING_RANGE_PX) {
      const score = dist;  // weight 1.0
      if (score < bestScore) {
        bestScore = score;
        bestPt = { x: state.lastPing.x, y: state.lastPing.y, kind: "ping" };
      }
    }
  }

  return bestPt;
}

/* moveToward -- generic move a Siren toward (tx, ty) at given speed,
 * capped by remaining distance. Sirens do NOT respect terrain (spec
 * section 7 is silent; preserves the step-2 design decision; flagged
 * for step 7 if pathfinding desired).
 * ------------------------------------------------------------------ */
function moveToward(siren, tx, ty, speed, dt) {
  const dx = tx - siren.x, dy = ty - siren.y;
  const dist = Math.hypot(dx, dy);
  const step = speed * dt;
  if (dist <= step || dist === 0) {
    siren.x = tx;
    siren.y = ty;
    return true;  // reached
  }
  siren.x += (dx / dist) * step;
  siren.y += (dy / dist) * step;
  return false;
}

/* ===================================================================
 * step 4 -- Sentinel update
 * Behavior:
 *   - Curious: if a decoy/ping target exists, move slowly to investigate
 *     (curiosity is cross-cutting per spec section 7). Otherwise orbit
 *     the power-core anchor.
 *   - Alert+: if sub inside SENTINEL_DETECT_RADIUS, ram at Alert speed;
 *     else if lastPing within detect radius, pursue lastPing; else orbit.
 * Always returns toward orbit ring when no other target.
 *
 * Detection inputs are consistent with Patroller (spec section 7
 * "consistent across all types"): proximity (sub inside detection
 * radius), active pings (lastPing), drone activity (curiosity), weapon
 * fire (step 5).
 * =================================================================== */
function updateSentinel(dt) {
  const s = state.sentinel;
  const alert = isAlertPlus(state.suspicion);
  const sub = state.sub;
  const dxSub = sub.x - s.x, dySub = sub.y - s.y;
  const distSub = Math.hypot(dxSub, dySub);

  if (alert) {
    // Detection check: sub inside SENTINEL_DETECT_RADIUS?
    if (distSub <= TUNING.SENTINEL_DETECT_RADIUS_PX) {
      // Pursue sub directly.
      s.mode = "pursuing";
      moveToward(s, sub.x, sub.y, TUNING.SENTINEL_ALERT_SPEED_PX_PER_SEC, dt);
      return;
    }
    // Else check lastPing
    if (state.lastPing.valid) {
      const dpx = state.lastPing.x - s.x, dpy = state.lastPing.y - s.y;
      const dPing = Math.hypot(dpx, dpy);
      if (dPing <= TUNING.SENTINEL_DETECT_RADIUS_PX) {
        s.mode = "pursuing";
        moveToward(s, state.lastPing.x, state.lastPing.y,
                   TUNING.SENTINEL_ALERT_SPEED_PX_PER_SEC, dt);
        return;
      }
    }
    // Sub/ping out of detection -- resume orbit
  } else {
    // Curious: investigate decoys/pings if present
    const target = findCuriosityTarget(s);
    if (target) {
      s.mode = "investigating";
      moveToward(s, target.x, target.y,
                 TUNING.SENTINEL_CURIOUS_SPEED_PX_PER_SEC, dt);
      return;
    }
  }

  // Return-to-orbit behavior (default).
  // First, walk back to the orbit ring if we drifted off it.
  const cx = TUNING.SENTINEL_ORBIT_CENTER_X;
  const cy = TUNING.SENTINEL_ORBIT_CENTER_Y;
  const r = TUNING.SENTINEL_ORBIT_RADIUS_PX;
  const dxC = s.x - cx, dyC = s.y - cy;
  const distFromCenter = Math.hypot(dxC, dyC);
  if (Math.abs(distFromCenter - r) > TUNING.SENTINEL_RETURN_TOLERANCE_PX) {
    // Aim for the nearest point on the ring.
    const angle = Math.atan2(dyC, dxC);
    const ringX = cx + Math.cos(angle) * r;
    const ringY = cy + Math.sin(angle) * r;
    s.mode = "returning";
    moveToward(s, ringX, ringY,
               alert ? TUNING.SENTINEL_ALERT_SPEED_PX_PER_SEC
                     : TUNING.SENTINEL_CURIOUS_SPEED_PX_PER_SEC, dt);
    // Update orbitAngle to match wherever we landed
    const ndx = s.x - cx, ndy = s.y - cy;
    s.orbitAngle = Math.atan2(ndy, ndx);
    return;
  }

  // Orbit: advance the angle.
  s.mode = "orbiting";
  s.orbitAngle += TUNING.SENTINEL_ORBIT_SPEED_RAD_PER_SEC * dt;
  s.x = cx + Math.cos(s.orbitAngle) * r;
  s.y = cy + Math.sin(s.orbitAngle) * r;
}

/* ===================================================================
 * step 4 -- Hunter update
 * Behavior:
 *   - Curious: dormant by default. If a decoy/ping target is present,
 *     investigate (curiosity is cross-cutting per spec section 7).
 *     Otherwise return to dormant position.
 *   - Alert+: pursue last-known contact (sub or lastPing) at high speed.
 * Hunter is "the threat your own noise summons" -- spec section 7.
 * =================================================================== */
function updateHunter(dt) {
  const h = state.hunter;
  const alert = isAlertPlus(state.suspicion);

  if (alert) {
    // Pursue: prefer sub if known via lastPing; else any lastPing; else
    // chase sub directly (sub is a "last-known contact" by virtue of
    // being percievable at all under Alert+ -- per spec section 7
    // "Hunter actively pursues last-known contact").
    let tx, ty;
    if (state.lastPing.valid) {
      tx = state.lastPing.x;
      ty = state.lastPing.y;
    } else {
      // No fresh ping -- pursue sub current position (Alert+ implies
      // detection per spec).
      tx = state.sub.x;
      ty = state.sub.y;
    }
    h.mode = "pursuing";
    const reached = moveToward(h, tx, ty, TUNING.HUNTER_PURSUE_SPEED_PX_PER_SEC, dt);
    if (reached && state.lastPing.valid) {
      // Arrived at ping origin; clear it so the deviation can resolve
      // (matches Patroller-deviation pattern).
      state.lastPing.valid = false;
    }
    return;
  }

  // Curious: investigate decoys/pings; if none, return to dormant.
  const target = findCuriosityTarget(h);
  if (target) {
    h.mode = "investigating";
    moveToward(h, target.x, target.y, TUNING.HUNTER_CURIOUS_SPEED_PX_PER_SEC, dt);
    return;
  }

  if (TUNING.HUNTER_RETURN_ACTIVE) {
    const dxD = TUNING.HUNTER_DORMANT_X - h.x;
    const dyD = TUNING.HUNTER_DORMANT_Y - h.y;
    if (Math.hypot(dxD, dyD) > 2) {
      h.mode = "returning";
      moveToward(h, TUNING.HUNTER_DORMANT_X, TUNING.HUNTER_DORMANT_Y,
                 TUNING.HUNTER_CURIOUS_SPEED_PX_PER_SEC, dt);
      return;
    }
  }
  h.mode = "dormant";
}

/* ===================================================================
 * step 4 -- Patroller curiosity extension
 * The existing step-2 updatePatroller handles patrolling + deviating
 * (Alert+ deviation). At Curious, the original behavior is to follow
 * the route. Brief 04 adds: at Curious, the Patroller will ALSO
 * investigate decoys/pings when they're closer than the next waypoint
 * (curiosity is cross-cutting per spec section 7).
 *
 * Implementation: we leave updatePatroller untouched for back-compat
 * (existing tests assert on it), and run a wrapper that checks for
 * curiosity attractors BEFORE delegating to updatePatroller. If a
 * curiosity target is present AND the patroller is at Curious, we
 * move toward the target instead.
 * =================================================================== */
function updatePatrollerWithCuriosity(dt) {
  const alert = isAlertPlus(state.suspicion);
  if (!alert) {
    const target = findCuriosityTarget(state.patroller);
    if (target) {
      state.patroller.mode = "investigating";
      moveToward(state.patroller, target.x, target.y,
                 TUNING.CURIOSITY_PATROLLER_SPEED_PX_PER_SEC, dt);
      // If we reached the target, fall back to nearest waypoint resume.
      const dxR = state.patroller.x - target.x;
      const dyR = state.patroller.y - target.y;
      if (Math.hypot(dxR, dyR) <= TUNING.CURIOSITY_REACH_PX) {
        state.patroller.waypointIdx = nearestWaypointIdx(state.patroller.x, state.patroller.y);
      }
      return;
    }
  }
  // Default: delegate to step-2 logic (patrolling / Alert+ deviating).
  updatePatroller(dt);
}

/* ----- step 3 -- Photo logic --------------------------------------- *
 * Two photographers exist: the selected drone (F) or the sub's
 * fallback cam (G). Each runs its range check against each objective.
 *
 * Drone photo: cheap range, costs +15 (spec section 3/6/11).
 * Sub-cam photo: tight range for most objectives; wide for silhouette
 *   (spec section 8: "silhouette is comfortably sub-cammable from
 *   distance"). No flat cost; the proximity to factory drives gain.
 *
 * Bonus objective (Siren close-up): drone within DRONE_SIREN_BONUS_RANGE
 * of the Patroller; sub-cam version is not awarded -- the spec calls
 * the bonus a "Siren at close range" objective and the drone is the
 * photogenic platform. Pothole logged: when Sentinel/Hunter exist in
 * step 4, this should match against any Siren, not just the Patroller.
 * ------------------------------------------------------------------- */
function tryDronePhoto() {
  if (state.loseReason || state.winState) return null;
  const d = getSelectedDrone();
  if (!d) return null;

  let captured = null;
  // Required objectives first.
  for (const o of state.objectives) {
    if (o.captured) continue;
    const dist = Math.hypot(d.x - o.x, d.y - o.y);
    if (dist <= TUNING.DRONE_PHOTO_RANGE_PX) {
      o.captured = true;
      captured = o;
      break;
    }
  }
  // Bonus -- Siren close-up. The drone must be near ANY Siren.
  // Step 4: was Patroller-only in step 3; now iterates the full Siren list.
  if (!captured && !state.bonus.captured) {
    for (const sir of allSirens()) {
      const dist = Math.hypot(d.x - sir.x, d.y - sir.y);
      if (dist <= TUNING.DRONE_SIREN_BONUS_RANGE_PX) {
        state.bonus.captured = true;
        captured = state.bonus;
        break;
      }
    }
  }
  if (captured) {
    applySuspicion(TUNING.DRONE_PHOTO_COST, "drone_photo");
    return captured;
  }
  return null;
}

function trySubCamPhoto() {
  if (state.loseReason || state.winState) return null;
  const s = state.sub;

  for (const o of state.objectives) {
    if (o.captured) continue;
    const dist = Math.hypot(s.x - o.x, s.y - o.y);
    const range = (o.id === "silhouette")
      ? TUNING.SUBCAM_SILHOUETTE_RANGE_PX
      : TUNING.SUBCAM_PHOTO_RANGE_PX;
    if (dist <= range) {
      o.captured = true;
      // Spec section 6: sub-cam carries no flat photo cost. The
      // proximity terms already running each tick are the cost.
      return o;
    }
  }
  return null;
}

/* ----- Update loop ------------------------------------------------- */
function update(dt) {
  if (state.loseReason || state.winState) return;

  state.timeSec += dt;

  /* ----- sub movement (step 1, FIX-PASS 2026-06-04 -- inertia) -----
   * Diagnostic 2 from Pat 2026-06-03: "the submarine needs to feel
   * like a submarine." Replaced direct-velocity WASD with:
   *   - Linear acceleration on thrust (forward stronger than reverse)
   *   - Linear drag (velocity decays when no thrust)
   *   - Speed cap at SUB_SPEED_PX_PER_SEC (terminal velocity)
   *   - Angular acceleration on turn input
   *   - Angular drag (turn rate decays when no turn input -- rudder
   *     centers, sub does not free-spin)
   *   - Turn rate cap at SUB_TURN_RATE_RAD_PER_SEC
   * Velocity is now persistent on state.sub.{vx,vy,angularVel} across
   * ticks. Existing `__sim` surface preserved (sub is still an entity
   * with x/y/heading; vx/vy still exposed for harness inspection).
   * ---------------------------------------------------------------- */
  let turn = 0, thrust = 0;
  if (keys.has("KeyA") || keys.has("ArrowLeft"))  turn -= 1;
  if (keys.has("KeyD") || keys.has("ArrowRight")) turn += 1;
  if (keys.has("KeyW") || keys.has("ArrowUp"))    thrust += 1;
  if (keys.has("KeyS") || keys.has("ArrowDown"))  thrust -= 1;

  applyInertia(dt, thrust, turn);

  const nextX = state.sub.x + state.sub.vx * dt;
  const nextY = state.sub.y + state.sub.vy * dt;

  if (state.hullHitCooldown > 0) state.hullHitCooldown -= dt;

  const r = TUNING.SUB_RADIUS_PX;

  let bumpedEdge = false;
  let clampedX = nextX, clampedY = nextY;
  if (clampedX < r)            { clampedX = r;           bumpedEdge = true; }
  if (clampedX > WORLD_W - r)  { clampedX = WORLD_W - r; bumpedEdge = true; }
  if (clampedY < r)            { clampedY = r;           bumpedEdge = true; }
  if (clampedY > WORLD_H - r)  { clampedY = WORLD_H - r; bumpedEdge = true; }

  let bumpedTerrain = false;
  for (const t of TERRAIN) {
    if (circleRectOverlap(clampedX, clampedY, r, t)) {
      const slideX = state.sub.x + state.sub.vx * dt;
      const slideXY2 = state.sub.y + state.sub.vy * dt;
      let resolvedX = state.sub.x, resolvedY = state.sub.y;
      if (!anyTerrainHit(slideX, state.sub.y, r) && slideX >= r && slideX <= WORLD_W - r) {
        resolvedX = slideX;
      }
      if (!anyTerrainHit(state.sub.x, slideXY2, r) && slideXY2 >= r && slideXY2 <= WORLD_H - r) {
        resolvedY = slideXY2;
      }
      clampedX = resolvedX;
      clampedY = resolvedY;
      bumpedTerrain = true;
      break;
    }
  }

  // step 3 -- factory wall counts as terrain for the sub (a hull bump
  // against the factory is a hull bump). Cheap re-use of the existing
  // hit/cooldown system.
  if (circleRectOverlap(clampedX, clampedY, r, FACTORY)) {
    const slideX = state.sub.x + state.sub.vx * dt;
    const slideXY2 = state.sub.y + state.sub.vy * dt;
    let resolvedX = state.sub.x, resolvedY = state.sub.y;
    if (!circleRectOverlap(slideX, state.sub.y, r, FACTORY) && slideX >= r && slideX <= WORLD_W - r) {
      resolvedX = slideX;
    }
    if (!circleRectOverlap(state.sub.x, slideXY2, r, FACTORY) && slideXY2 >= r && slideXY2 <= WORLD_H - r) {
      resolvedY = slideXY2;
    }
    clampedX = resolvedX;
    clampedY = resolvedY;
    bumpedTerrain = true;
  }

  state.sub.x = clampedX;
  state.sub.y = clampedY;

  // Step 1 fix-pass 2026-06-04: on collision, zero the velocity components
  // that drove the sub into the obstacle. Without this the inertial
  // velocity persists across the bump and the sub keeps "pressing"
  // into the wall every tick, draining hull every cooldown interval.
  if (bumpedEdge) {
    if (clampedX === r || clampedX === WORLD_W - r) state.sub.vx = 0;
    if (clampedY === r || clampedY === WORLD_H - r) state.sub.vy = 0;
  }
  if (bumpedTerrain) {
    // Cheap heuristic: zero both linear components. Terrain rectangles are
    // interior shapes so the player was pushed back along whichever axis
    // was unblocked; preserving the other axis can re-clip the next tick.
    // Zeroing both is safer and matches "sub bumps rock and stops" feel.
    state.sub.vx = 0;
    state.sub.vy = 0;
  }

  if ((bumpedEdge || bumpedTerrain) && state.hullHitCooldown <= 0) {
    state.hull -= 1;
    state.hullHitCooldown = TUNING.HULL_HIT_COOLDOWN_SEC;
    if (state.hull <= 0) {
      state.hull = 0;
      state.loseReason = "sunk";
    }
  }

  /* ----- oxygen (step 1) ----- */
  state.oxygen -= dt;
  if (state.oxygen <= 0) {
    state.oxygen = 0;
    if (!state.loseReason) state.loseReason = "suffocated";
  }

  /* ----- step 2 fairness valve (BEFORE decay -- see step 2 comment) ----- */
  if (state.suspicion >= TUNING.SUSP_MAX) {
    state.instakillTimer += dt;
    if (state.instakillTimer >= TUNING.INSTAKILL_SUSTAIN_SEC) {
      state.loseReason = "vaporized";
    }
  } else {
    state.instakillTimer = 0;
  }

  /* ----- step 2 suspicion decay, EXTENDED by step 3 factory proximity ---
   * Step 2 logic preserved: decay -5/sec when ping is NOT active.
   * Step 3 adds: factory proximity gain +1..+3/sec ALWAYS (independent
   * of ping state). Net rate near the factory while not pinging:
   *   far     -> -5 + 1 = -4/s  (still decays, just slower)
   *   mid     -> -5 + 2 = -3/s
   *   near    -> -5 + 3 = -2/s
   *   outside -> -5/s (pure decay)
   * Inside the ping window, decay is paused (step 2 choice) but
   * factory proximity STILL adds gain -- "factory hugging during a
   * ping" is the worst combination, which feels right.
   *
   * Siren-near-sub +scaling/sec is the OTHER continuous term in spec
   * section 6 -- deferred to step 4 (only one Siren currently exists;
   * the brief explicitly defers).
   * -------------------------------------------------------------- */
  const pingElapsed = state.timeSec - state.ping.tStart;
  const pingActive = pingElapsed >= 0 && pingElapsed <= TUNING.PING_DURATION_SEC;

  const factoryGain = factoryProximityGainPerSec(state.sub.x, state.sub.y);
  // step 4: Siren-near-sub +scaling/sec (spec section 6). Sums across
  // all 3 Siren types using per-type proximity range + max rate.
  const sirenGain = sirenProximityGainPerSec(state.sub.x, state.sub.y);

  let netRate = 0;
  if (!pingActive) netRate -= TUNING.SUSP_DECAY_PER_SEC;
  netRate += factoryGain;
  netRate += sirenGain;

  if (netRate !== 0) {
    const before = state.suspicion;
    state.suspicion = clamp(
      state.suspicion + netRate * dt,
      TUNING.SUSP_MIN, TUNING.SUSP_MAX
    );
    state.lastSuspChange = state.suspicion - before;
  }

  /* ----- step 2 Patroller (extended with curiosity per step 4) ----- */
  updatePatrollerWithCuriosity(dt);
  /* ----- step 4 Sentinel + Hunter updates ----- */
  updateSentinel(dt);
  updateHunter(dt);

  /* ----- Siren-sub contact at Alert+ (Patroller, Sentinel, Hunter) -----
   * All three Siren types ram the sub at Alert+ per spec section 6
   * ("Alert: Sirens converge on last-known contact ... ram sub")
   * and section 7 (Sentinel "forces tool use" by being in your zone;
   * Hunter "actively pursues"). Reach is sub radius + per-type body
   * radius. Single 0.6s hull cooldown is shared so multiple Sirens
   * stacking on the sub at once don't multi-drain (INV5 fairness).
   * --------------------------------------------------------------- */
  if (isAlertPlus(state.suspicion) && state.hullHitCooldown <= 0) {
    for (const ramCheck of [
      { siren: state.patroller, r: TUNING.PATROL_RADIUS_PX,   dmg: TUNING.PATROL_RAM_HULL_DMG },
      { siren: state.sentinel,  r: TUNING.SENTINEL_RADIUS_PX, dmg: TUNING.SENTINEL_RAM_HULL_DMG },
      { siren: state.hunter,    r: TUNING.HUNTER_RADIUS_PX,   dmg: TUNING.HUNTER_RAM_HULL_DMG },
    ]) {
      const dx = ramCheck.siren.x - state.sub.x;
      const dy = ramCheck.siren.y - state.sub.y;
      const reach = TUNING.SUB_RADIUS_PX + ramCheck.r;
      if (dx * dx + dy * dy <= reach * reach) {
        state.hull -= ramCheck.dmg;
        state.hullHitCooldown = TUNING.HULL_HIT_COOLDOWN_SEC;
        if (state.hull <= 0) {
          state.hull = 0;
          if (!state.loseReason) state.loseReason = "sunk";
        }
        break;  // one ram event per cooldown
      }
    }
  }

  /* ----- step 3 -- drones move; check destruction --------------- *
   * Drone destruction conditions:
   *   1. Drone moves into terrain or out of bounds while traveling
   *      (terrain check before moving; if blocked, the drone is dead --
   *      a deployed drone that runs into a rock is gone, per the spec
   *      "destroyed drones are gone").
   *   2. Patroller at Alert+ touches a drone. (At Curious, the
   *      Patroller does NOT destroy drones in this step; that
   *      behavior surfaces in step 4 with the curiosity/decoy
   *      framework.)
   * ------------------------------------------------------------- */
  for (const d of state.drones) {
    if (!d.alive) continue;

    const tdx = d.targetX - d.x;
    const tdy = d.targetY - d.y;
    const dist = Math.hypot(tdx, tdy);
    if (dist > TUNING.DRONE_ARRIVAL_TOLERANCE_PX) {
      const step = TUNING.DRONE_SPEED_PX_PER_SEC * dt;
      let nx, ny;
      if (dist <= step) { nx = d.targetX; ny = d.targetY; }
      else { nx = d.x + (tdx / dist) * step; ny = d.y + (tdy / dist) * step; }

      // Out-of-bounds = destroyed (shouldn't happen since deploy/redirect
      // both clamp via the canvas, but defensive).
      if (nx < 0 || ny < 0 || nx > WORLD_W || ny > WORLD_H) {
        d.alive = false;
        continue;
      }
      // Terrain hit OR factory hit = destroyed.
      if (anyTerrainHit(nx, ny, TUNING.DRONE_RADIUS_PX) ||
          circleRectOverlap(nx, ny, TUNING.DRONE_RADIUS_PX, FACTORY)) {
        d.alive = false;
        continue;
      }
      d.x = nx;
      d.y = ny;
    }

    // Siren contact at Alert+ kills the drone (Patroller, Sentinel,
    // Hunter all behave identically here -- spec section 6 "destroy
    // drones" at Alert). At Curious, all Sirens leave drones alone --
    // the curiosity behavior is "approach to investigate," not destroy
    // (spec section 7 "approachable, baitable, photogenic"). This
    // preserves the spec's exploit verb: park a drone to bait a
    // Curious Siren and photograph it.
    if (isAlertPlus(state.suspicion)) {
      for (const sirCheck of [
        { siren: state.patroller, r: TUNING.PATROL_RADIUS_PX },
        { siren: state.sentinel,  r: TUNING.SENTINEL_RADIUS_PX },
        { siren: state.hunter,    r: TUNING.HUNTER_RADIUS_PX },
      ]) {
        const pdx = d.x - sirCheck.siren.x;
        const pdy = d.y - sirCheck.siren.y;
        const pr2 = (sirCheck.r + TUNING.DRONE_RADIUS_PX);
        if (pdx * pdx + pdy * pdy <= pr2 * pr2) {
          d.alive = false;
          break;
        }
      }
    }
  }

  // Garbage collect dead drone selection so cycleSelectedDrone works.
  if (state.selectedDroneId != null) {
    const sel = state.drones.find(d => d.id === state.selectedDroneId);
    if (!sel || !sel.alive) {
      const alive = state.drones.filter(d => d.alive);
      state.selectedDroneId = alive.length ? alive[0].id : null;
    }
  }

  /* ----- step 3 -- win condition ------------------------------- *
   * Spec section 8: win = all required photos captured AND sub
   * reaches extraction. Bonus is not required (per spec).
   * ------------------------------------------------------------- */
  const allRequired = state.objectives.every(o => o.captured);
  if (allRequired) {
    const dxe = state.sub.x - EXTRACTION.x;
    const dye = state.sub.y - EXTRACTION.y;
    if (dxe * dxe + dye * dye <= EXTRACTION.r * EXTRACTION.r) {
      state.winState = true;
    }
  }
}

/* ----- Patroller update (step 2, unchanged) ------------------------ */
function updatePatroller(dt) {
  const p = state.patroller;
  const alert = isAlertPlus(state.suspicion);

  if (alert && state.lastPing.valid) {
    p.mode = "deviating";
  } else {
    p.mode = "patrolling";
  }

  let targetX, targetY;
  if (p.mode === "deviating") {
    targetX = state.lastPing.x;
    targetY = state.lastPing.y;
  } else {
    const wp = PATROL_ROUTE[p.waypointIdx];
    targetX = wp.x;
    targetY = wp.y;
  }

  const dx = targetX - p.x;
  const dy = targetY - p.y;
  const dist = Math.hypot(dx, dy);
  const baseSpeed = TUNING.PATROL_SPEED_PX_PER_SEC;
  const sp = alert ? baseSpeed * TUNING.PATROL_ALERT_SPEED_MULT : baseSpeed;
  const step = sp * dt;

  if (dist <= step) {
    p.x = targetX;
    p.y = targetY;
    if (p.mode === "patrolling") {
      p.waypointIdx = (p.waypointIdx + 1) % PATROL_ROUTE.length;
    } else {
      state.lastPing.valid = false;
      p.waypointIdx = nearestWaypointIdx(p.x, p.y);
    }
  } else if (dist > 0) {
    p.x += (dx / dist) * step;
    p.y += (dy / dist) * step;
  }

  if (p.mode === "deviating") {
    const ddx = state.lastPing.x - p.x;
    const ddy = state.lastPing.y - p.y;
    const reach2 = TUNING.PATROL_DEVIATION_REACH_PX * TUNING.PATROL_DEVIATION_REACH_PX;
    if (ddx * ddx + ddy * ddy <= reach2) {
      state.lastPing.valid = false;
      p.waypointIdx = nearestWaypointIdx(p.x, p.y);
    }
  }
}

function nearestWaypointIdx(x, y) {
  let bestIdx = 0, bestDist = Infinity;
  for (let i = 0; i < PATROL_ROUTE.length; i++) {
    const wp = PATROL_ROUTE[i];
    const d = (wp.x - x) * (wp.x - x) + (wp.y - y) * (wp.y - y);
    if (d < bestDist) { bestDist = d; bestIdx = i; }
  }
  return bestIdx;
}

function anyTerrainHit(x, y, r) {
  for (const t of TERRAIN) if (circleRectOverlap(x, y, r, t)) return true;
  return false;
}

function circleRectOverlap(cx, cy, cr, rect) {
  const rx = Math.max(rect.x, Math.min(cx, rect.x + rect.w));
  const ry = Math.max(rect.y, Math.min(cy, rect.y + rect.h));
  const dx = cx - rx, dy = cy - ry;
  return (dx * dx + dy * dy) < (cr * cr);
}

/* ----- Step 1 FIX-PASS 2026-06-04: submarine inertia helpers -------- *
 *
 * applyInertia(dt, thrust, turn)
 *   thrust in [-1, 0, +1] from W/S input (forward positive)
 *   turn   in [-1, 0, +1] from A/D input (right positive)
 *
 * Forward thrust adds acceleration along the current heading. Reverse
 * is the same shape but multiplied by SUB_REVERSE_ACCEL_MULT (subs
 * are not built to back up briskly). When no thrust, linear drag
 * bleeds the velocity vector exponentially: v *= (1 - drag*dt) per
 * tick. Speed is clamped to SUB_SPEED_PX_PER_SEC.
 *
 * Turn input adds angular acceleration. Drag pulls angularVel toward
 * zero when no turn input (rudder centers). Angular velocity is
 * clamped to +/- SUB_TURN_RATE_RAD_PER_SEC. Heading integrates from
 * angularVel.
 *
 * Exposed via __sim.applyInertia for headless sim tests.
 * ------------------------------------------------------------------- */
function applyInertia(dt, thrust, turn) {
  const s = state.sub;

  // --- linear ---
  if (thrust !== 0) {
    const accelMag = (thrust > 0)
      ? TUNING.SUB_LINEAR_ACCEL_PX_PER_SEC2
      : TUNING.SUB_LINEAR_ACCEL_PX_PER_SEC2 * TUNING.SUB_REVERSE_ACCEL_MULT;
    const ax = Math.cos(s.heading) * accelMag * thrust;
    const ay = Math.sin(s.heading) * accelMag * thrust;
    s.vx += ax * dt;
    s.vy += ay * dt;
  } else {
    // Exponential drag toward zero velocity. Clamp factor to [0,1] so
    // a huge dt cannot flip velocity sign.
    const k = Math.max(0, 1 - TUNING.SUB_LINEAR_DRAG_PER_SEC * dt);
    s.vx *= k;
    s.vy *= k;
  }
  // Speed cap.
  const speed = Math.hypot(s.vx, s.vy);
  const maxSpeed = TUNING.SUB_SPEED_PX_PER_SEC;
  if (speed > maxSpeed) {
    const scale = maxSpeed / speed;
    s.vx *= scale;
    s.vy *= scale;
  }

  // --- angular ---
  if (turn !== 0) {
    s.angularVel += turn * TUNING.SUB_TURN_ACCEL_RAD_PER_SEC2 * dt;
  } else {
    const kt = Math.max(0, 1 - TUNING.SUB_TURN_DRAG_PER_SEC * dt);
    s.angularVel *= kt;
  }
  // Turn rate cap.
  const maxTurn = TUNING.SUB_TURN_RATE_RAD_PER_SEC;
  if (s.angularVel >  maxTurn) s.angularVel =  maxTurn;
  if (s.angularVel < -maxTurn) s.angularVel = -maxTurn;
  s.heading += s.angularVel * dt;
}

/* ----- Step 1 FIX-PASS 2026-06-04: line-of-sight raycast helpers --- *
 *
 * segmentRectIntersect(x1,y1,x2,y2,rect) -> boolean
 *   True iff line segment (x1,y1)-(x2,y2) crosses or touches the
 *   rectangle's interior. Uses Liang-Barsky parametric clipping --
 *   robust, no floating-point degeneracies on axis-aligned segments.
 *
 * isLineOfSightClear(x1,y1,x2,y2) -> boolean
 *   True iff the segment is unblocked by any TERRAIN rect OR the
 *   FACTORY rect. Used for passive sonar / active ping / drone-cam
 *   visibility tests against entities (Patroller, drones, factory,
 *   objectives).
 *
 * raycastTerrainHit(x1,y1,x2,y2) -> { rect, t } | null
 *   Returns the first occluder along the segment plus the parametric
 *   t in [0,1]. Currently unused by render, exposed via __sim for
 *   downstream sim tests and step-4 use.
 *
 * Rationale (Pat 2026-06-03 diagnostic 1): passive sonar through rock
 * is wrong. Spec section 3 calls passive sonar "near-blind ... rough
 * nearby blips" -- not "X-ray vision in a 90 px circle." Both passive
 * AND active reveal must be terrain-occluded. Pat's parallel
 * implementation occludes both and it "feels great."
 * ------------------------------------------------------------------- */
function segmentRectIntersect(x1, y1, x2, y2, rect) {
  // Liang-Barsky line clipping against an AABB.
  const xmin = rect.x, ymin = rect.y;
  const xmax = rect.x + rect.w, ymax = rect.y + rect.h;
  const dx = x2 - x1, dy = y2 - y1;
  let p, q, r;
  let u1 = 0, u2 = 1;
  for (let edge = 0; edge < 4; edge++) {
    if (edge === 0) { p = -dx; q = x1 - xmin; }
    else if (edge === 1) { p =  dx; q = xmax - x1; }
    else if (edge === 2) { p = -dy; q = y1 - ymin; }
    else                 { p =  dy; q = ymax - y1; }

    if (p === 0) {
      if (q < 0) return false;     // parallel and outside slab
      // parallel and inside: no constraint from this edge
    } else {
      r = q / p;
      if (p < 0) {
        if (r > u2) return false;
        if (r > u1) u1 = r;
      } else {
        if (r < u1) return false;
        if (r < u2) u2 = r;
      }
    }
  }
  return u1 <= u2 && u2 >= 0 && u1 <= 1;
}

function isLineOfSightClear(x1, y1, x2, y2) {
  for (const t of TERRAIN) {
    if (segmentRectIntersect(x1, y1, x2, y2, t)) return false;
  }
  if (segmentRectIntersect(x1, y1, x2, y2, FACTORY)) return false;
  return true;
}

function raycastTerrainHit(x1, y1, x2, y2) {
  // Returns first occluder along the segment (smallest entry param) or null.
  let best = null;
  let bestT = Infinity;
  const candidates = TERRAIN.concat([FACTORY]);
  for (const rect of candidates) {
    const t = _segmentRectEntryParam(x1, y1, x2, y2, rect);
    if (t !== null && t < bestT) { bestT = t; best = rect; }
  }
  return best ? { rect: best, t: bestT } : null;
}

function _segmentRectEntryParam(x1, y1, x2, y2, rect) {
  // Same Liang-Barsky machinery but returns the entry parameter (u1)
  // if the segment crosses the rect, otherwise null.
  const xmin = rect.x, ymin = rect.y;
  const xmax = rect.x + rect.w, ymax = rect.y + rect.h;
  const dx = x2 - x1, dy = y2 - y1;
  let p, q, r;
  let u1 = 0, u2 = 1;
  for (let edge = 0; edge < 4; edge++) {
    if (edge === 0) { p = -dx; q = x1 - xmin; }
    else if (edge === 1) { p =  dx; q = xmax - x1; }
    else if (edge === 2) { p = -dy; q = y1 - ymin; }
    else                 { p =  dy; q = ymax - y1; }
    if (p === 0) {
      if (q < 0) return null;
    } else {
      r = q / p;
      if (p < 0) { if (r > u2) return null; if (r > u1) u1 = r; }
      else       { if (r < u1) return null; if (r < u2) u2 = r; }
    }
  }
  if (u1 > u2) return null;
  return Math.max(0, u1);
}

/* losClearIgnoring -- like isLineOfSightClear but skips a specific rect.
 * Used when testing visibility of an entity AGAINST the world while
 * not letting the entity's own bounding rect occlude itself. Example:
 * testing FACTORY visibility from the passive radius center -- the LOS
 * ray to the factory's nearest point may graze the factory's own edge
 * (the ray ENDS there), which should not count as occlusion by the
 * factory itself.
 * ------------------------------------------------------------------- */
function losClearIgnoring(x1, y1, x2, y2, skipRect) {
  for (const t of TERRAIN) {
    if (t === skipRect) continue;
    if (segmentRectIntersect(x1, y1, x2, y2, t)) return false;
  }
  if (FACTORY !== skipRect && segmentRectIntersect(x1, y1, x2, y2, FACTORY)) return false;
  return true;
}

/* ----- Render (placeholder shapes only, INV6) ---------------------- */
function render() {
  ctx.fillStyle = "#000";
  ctx.fillRect(0, 0, WORLD_W, WORLD_H);

  const pingElapsed = state.timeSec - state.ping.tStart;
  const pingActive = pingElapsed >= 0 && pingElapsed <= TUNING.PING_DURATION_SEC;
  const pingAlpha = pingActive ? (1 - pingElapsed / TUNING.PING_DURATION_SEC) : 0;

  // Passive reveal (sub).
  drawWorldNear(state.sub.x, state.sub.y, TUNING.PASSIVE_RADIUS_PX, 0.35);

  // Drone-cam reveals (free per spec section 3 to deploy/move).
  for (const d of state.drones) {
    if (!d.alive) continue;
    drawWorldNear(d.x, d.y, TUNING.DRONE_VISION_RADIUS_PX, 0.40);
  }

  // Active ping reveal (transient, fades).
  if (pingActive) {
    const pingReachedRadius = TUNING.PING_RADIUS_PX * (pingElapsed / TUNING.PING_DURATION_SEC);
    drawWorldNear(state.ping.originX, state.ping.originY, pingReachedRadius, 0.6 * pingAlpha);

    ctx.beginPath();
    ctx.arc(state.ping.originX, state.ping.originY, pingReachedRadius, 0, Math.PI * 2);
    ctx.strokeStyle = "rgba(120, 200, 255, " + (0.5 * pingAlpha) + ")";
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  // Extraction point: always visible (a beacon -- diegetic exception to
  // the "darkness everywhere" model; the sub knows where home is).
  drawExtraction();

  // Patroller / Sentinel / Hunter (visible within passive sonar, active
  // ping, OR drone-cam vision -- drones are eyes). LOS-gated per step
  // 1 fix-pass (Pat 2026-06-03 diagnostic 1).
  drawSirenIfVisible(state.patroller, "PATROLLER", TUNING.PATROL_RADIUS_PX, pingActive, pingAlpha);
  drawSirenIfVisible(state.sentinel,  "SENTINEL",  TUNING.SENTINEL_RADIUS_PX, pingActive, pingAlpha);
  drawSirenIfVisible(state.hunter,    "HUNTER",    TUNING.HUNTER_RADIUS_PX, pingActive, pingAlpha);

  // Drones themselves drawn always (you can always see your own deployed
  // drones; they have telemetry).
  for (const d of state.drones) {
    if (!d.alive) continue;
    drawDrone(d);
  }

  drawSub();

  // Warning text (step 2, unchanged).
  if (state.suspicion >= TUNING.WARNING_THRESHOLD && !state.loseReason && !state.winState) {
    ctx.fillStyle = "rgba(255, 80, 80, 0.85)";
    ctx.font = "20px monospace";
    ctx.textAlign = "center";
    ctx.fillText("WARNING", WORLD_W / 2, 36);
    if (state.suspicion >= TUNING.SUSP_MAX) {
      ctx.fillStyle = "rgba(255, 200, 60, 0.95)";
      ctx.font = "14px monospace";
      const remaining = Math.max(0, TUNING.INSTAKILL_SUSTAIN_SEC - state.instakillTimer);
      ctx.fillText("instakill imminent -- break contact (" + remaining.toFixed(1) + "s)", WORLD_W / 2, 58);
    }
    ctx.textAlign = "left";
  }

  // Lose overlay.
  if (state.loseReason) {
    ctx.fillStyle = "rgba(0,0,0,0.6)";
    ctx.fillRect(0, 0, WORLD_W, WORLD_H);
    ctx.fillStyle = "#fff";
    ctx.font = "24px monospace";
    ctx.textAlign = "center";
    const msg =
        state.loseReason === "sunk"       ? "you lost (sunk)"
      : state.loseReason === "suffocated" ? "you lost (suffocated)"
      : state.loseReason === "vaporized"  ? "you lost (vaporized -- Siren strike)"
      :                                     "you lost (" + state.loseReason + ")";
    ctx.fillText(msg, WORLD_W / 2, WORLD_H / 2 - 10);
    ctx.font = "14px monospace";
    ctx.fillText("press R to restart", WORLD_W / 2, WORLD_H / 2 + 20);
    ctx.textAlign = "left";
  }

  // Win overlay (step 3).
  if (state.winState) {
    ctx.fillStyle = "rgba(0,0,0,0.55)";
    ctx.fillRect(0, 0, WORLD_W, WORLD_H);
    ctx.fillStyle = "#fff";
    ctx.font = "24px monospace";
    ctx.textAlign = "center";
    ctx.fillText("EXTRACTED -- RUN COMPLETE", WORLD_W / 2, WORLD_H / 2 - 10);
    ctx.font = "14px monospace";
    const bonusStr = state.bonus.captured ? " (bonus: Siren close-up captured)" : "";
    ctx.fillText("photos " + state.objectives.filter(o => o.captured).length + "/3 required" + bonusStr, WORLD_W / 2, WORLD_H / 2 + 14);
    ctx.fillText("press R to restart", WORLD_W / 2, WORLD_H / 2 + 38);
    ctx.textAlign = "left";
  }
}

/* drawWorldNear -- draws terrain + factory + objectives within a clip
 * radius around (cx, cy). This is the unified "things in this reveal
 * window" pass; passive sonar, ping, and drone-cam all funnel through it.
 *
 * Step 1 FIX-PASS 2026-06-04 (Pat 2026-06-03 diagnostic 1):
 *   LOS occlusion is now applied. Terrain rectangles are themselves
 *   the occluders -- they always render inside the reveal disc (you
 *   see the near face of a rock you are next to). The FACTORY rect
 *   renders only if its nearest point has LOS from (cx, cy); a factory
 *   hidden behind a rock should not silhouette through. The objective
 *   markers (interior to the factory) only render when LOS from
 *   (cx, cy) to the marker is clear. This means the silhouette, bays,
 *   and power-core markers are no longer visible through walls from
 *   passive radius -- the player has to actually see the approach.
 * ------------------------------------------------------------------- */
function drawWorldNear(cx, cy, radius, alpha) {
  ctx.save();
  ctx.beginPath();
  ctx.arc(cx, cy, radius, 0, Math.PI * 2);
  ctx.clip();

  // Terrain rectangles -- always rendered (they ARE the occluders;
  // the near face of a wall is visible to anyone next to it).
  ctx.fillStyle = "rgba(120, 130, 150, " + alpha + ")";
  for (const t of TERRAIN) ctx.fillRect(t.x, t.y, t.w, t.h);

  // Factory body: LOS-gated. Test against the nearest point on the
  // factory rect from the reveal center. Skip the factory rect itself
  // in the LOS check (a ray that ends on the factory edge would
  // otherwise self-occlude).
  const fNearX = Math.max(FACTORY.x, Math.min(cx, FACTORY.x + FACTORY.w));
  const fNearY = Math.max(FACTORY.y, Math.min(cy, FACTORY.y + FACTORY.h));
  const factoryVisible = losClearIgnoring(cx, cy, fNearX, fNearY, FACTORY);
  if (factoryVisible) {
    ctx.fillStyle = "rgba(160, 110, 110, " + (alpha * 1.0) + ")";
    ctx.fillRect(FACTORY.x, FACTORY.y, FACTORY.w, FACTORY.h);
    ctx.strokeStyle = "rgba(220, 160, 160, " + alpha + ")";
    ctx.lineWidth = 1;
    ctx.strokeRect(FACTORY.x, FACTORY.y, FACTORY.w, FACTORY.h);
    ctx.fillStyle = "rgba(240, 220, 220, " + alpha + ")";
    ctx.font = "11px monospace";
    ctx.textAlign = "center";
    ctx.fillText("FACTORY", FACTORY.cx, FACTORY.y - 4);
    ctx.textAlign = "left";
  }

  // Objective markers (rendered with captured/uncaptured states).
  // LOS-gated -- an objective behind a wall or factory is invisible
  // until the reveal origin can see it directly.
  ctx.font = "10px monospace";
  ctx.textAlign = "center";
  for (const o of state.objectives) {
    if (!isLineOfSightClear(cx, cy, o.x, o.y)) continue;
    const marker = o.captured ? "rgba(140, 220, 140, " + alpha + ")"
                              : "rgba(255, 230, 120, " + alpha + ")";
    ctx.fillStyle = marker;
    ctx.fillRect(o.x - 5, o.y - 5, 10, 10);
    ctx.fillStyle = "rgba(240, 240, 240, " + alpha + ")";
    ctx.fillText((o.captured ? "[X] " : "[ ] ") + o.name, o.x, o.y - 8);
  }
  ctx.textAlign = "left";

  // World-edge stroke (so you can see the play-area boundary).
  ctx.strokeStyle = "rgba(80, 100, 130, " + alpha + ")";
  ctx.lineWidth = 1;
  ctx.strokeRect(0, 0, WORLD_W, WORLD_H);

  ctx.restore();
}

function drawExtraction() {
  // Beacon -- always visible. INV6: plain marker, label.
  ctx.beginPath();
  ctx.arc(EXTRACTION.x, EXTRACTION.y, EXTRACTION.r, 0, Math.PI * 2);
  ctx.strokeStyle = "rgba(80, 220, 160, 0.7)";
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.fillStyle = "rgba(80, 220, 160, 0.15)";
  ctx.fill();
  ctx.fillStyle = "rgba(160, 240, 200, 0.95)";
  ctx.font = "11px monospace";
  ctx.textAlign = "center";
  ctx.fillText("EXTRACTION", EXTRACTION.x, EXTRACTION.y - EXTRACTION.r - 4);
  ctx.textAlign = "left";
}

function drawSirenIfVisible(siren, label, bodyRadius, pingActive, pingAlpha) {
  const dxSub = siren.x - state.sub.x;
  const dySub = siren.y - state.sub.y;
  const distSub2 = dxSub * dxSub + dySub * dySub;
  // Step 1 FIX-PASS 2026-06-04: each detection mode requires LOS clear
  // from the reveal origin to the Siren. Passive ring through rock no
  // longer silhouettes any Siren (Pat 2026-06-03 diag 1).
  const inPassive = (distSub2 <= TUNING.PASSIVE_RADIUS_PX * TUNING.PASSIVE_RADIUS_PX)
                 && isLineOfSightClear(state.sub.x, state.sub.y, siren.x, siren.y);

  let inPing = false;
  let pingVisAlpha = 0;
  if (pingActive) {
    const dxPing = siren.x - state.ping.originX;
    const dyPing = siren.y - state.ping.originY;
    const pingElapsed = state.timeSec - state.ping.tStart;
    const pingReachedRadius = TUNING.PING_RADIUS_PX * (pingElapsed / TUNING.PING_DURATION_SEC);
    const d2 = dxPing * dxPing + dyPing * dyPing;
    if (d2 <= pingReachedRadius * pingReachedRadius
        && isLineOfSightClear(state.ping.originX, state.ping.originY, siren.x, siren.y)) {
      inPing = true;
      pingVisAlpha = pingAlpha;
    }
  }

  // Drone-cam reveals all Sirens too (also LOS-gated).
  let inDrone = false;
  for (const d of state.drones) {
    if (!d.alive) continue;
    const ddx = siren.x - d.x;
    const ddy = siren.y - d.y;
    if (ddx * ddx + ddy * ddy <= TUNING.DRONE_VISION_RADIUS_PX * TUNING.DRONE_VISION_RADIUS_PX
        && isLineOfSightClear(d.x, d.y, siren.x, siren.y)) {
      inDrone = true;
      break;
    }
  }

  if (!inPassive && !inPing && !inDrone) return;

  const alpha = Math.max(
    inPassive ? 0.7 : 0,
    inPing ? 0.85 * pingVisAlpha : 0,
    inDrone ? 0.75 : 0
  );

  ctx.beginPath();
  ctx.arc(siren.x, siren.y, bodyRadius, 0, Math.PI * 2);
  // Per-type color hint at Curious (testing legibility aid, NOT a form
  // decision per INV6). At Alert+ all Sirens flip to red.
  if (isAlertPlus(state.suspicion)) {
    ctx.fillStyle = "rgba(220, 80, 80, " + alpha + ")";
  } else if (siren.type === "sentinel") {
    ctx.fillStyle = "rgba(140, 160, 240, " + alpha + ")";  // bluish guard
  } else if (siren.type === "hunter") {
    ctx.fillStyle = "rgba(220, 180, 80, " + alpha + ")";   // yellow-orange threat
  } else {
    ctx.fillStyle = "rgba(120, 200, 140, " + alpha + ")";  // greenish patrol
  }
  ctx.fill();
  ctx.strokeStyle = "rgba(40, 40, 40, " + alpha + ")";
  ctx.lineWidth = 1;
  ctx.stroke();

  ctx.fillStyle = "rgba(240, 240, 240, " + alpha + ")";
  ctx.font = "10px monospace";
  ctx.textAlign = "center";
  const modeStr = siren.mode ? ("(" + siren.mode + ")") : "";
  ctx.fillText(label + " " + modeStr, siren.x, siren.y - bodyRadius - 4);
  ctx.textAlign = "left";
}

// Back-compat alias for any external/test reference to drawPatrollerIfVisible.
function drawPatrollerIfVisible(pingActive, pingAlpha) {
  drawSirenIfVisible(state.patroller, "PATROLLER", TUNING.PATROL_RADIUS_PX, pingActive, pingAlpha);
}

function drawDrone(d) {
  // Vision ring (a faint hint of the drone-cam reveal radius).
  ctx.beginPath();
  ctx.arc(d.x, d.y, TUNING.DRONE_VISION_RADIUS_PX, 0, Math.PI * 2);
  ctx.strokeStyle = "rgba(160, 200, 240, 0.10)";
  ctx.lineWidth = 1;
  ctx.stroke();

  // Drone body.
  const selected = (d.id === state.selectedDroneId);
  ctx.beginPath();
  ctx.arc(d.x, d.y, TUNING.DRONE_RADIUS_PX, 0, Math.PI * 2);
  ctx.fillStyle = selected ? "rgba(255, 255, 120, 0.95)" : "rgba(200, 220, 255, 0.85)";
  ctx.fill();
  ctx.strokeStyle = "rgba(40, 60, 100, 0.9)";
  ctx.lineWidth = 1;
  ctx.stroke();

  // Drone id (small).
  ctx.fillStyle = "rgba(240, 240, 240, 0.9)";
  ctx.font = "9px monospace";
  ctx.textAlign = "center";
  ctx.fillText("d" + d.id + (selected ? "*" : ""), d.x, d.y - TUNING.DRONE_RADIUS_PX - 3);
  ctx.textAlign = "left";

  // Target line (faint).
  if (Math.hypot(d.targetX - d.x, d.targetY - d.y) > TUNING.DRONE_ARRIVAL_TOLERANCE_PX) {
    ctx.beginPath();
    ctx.moveTo(d.x, d.y);
    ctx.lineTo(d.targetX, d.targetY);
    ctx.strokeStyle = "rgba(180, 200, 240, 0.18)";
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // Decoy mode indicator (step 4 -- placeholder ring at the active
  // decoy range so the player can see the draw envelope). INV6: a
  // labeled ring, not a sprite or palette piece.
  if (d.decoyMode) {
    ctx.beginPath();
    ctx.arc(d.x, d.y, TUNING.CURIOSITY_ACTIVE_DECOY_RANGE_PX, 0, Math.PI * 2);
    ctx.strokeStyle = "rgba(255, 200, 100, 0.20)";
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = "rgba(255, 200, 100, 0.95)";
    ctx.font = "8px monospace";
    ctx.textAlign = "center";
    ctx.fillText("DECOY", d.x, d.y + TUNING.DRONE_RADIUS_PX + 9);
    ctx.textAlign = "left";
  }
}

function drawSub() {
  const s = state.sub;
  const r = TUNING.SUB_RADIUS_PX;
  ctx.save();
  ctx.translate(s.x, s.y);
  ctx.rotate(s.heading);
  ctx.beginPath();
  ctx.moveTo( r * 1.4, 0);
  ctx.lineTo(-r,  r * 0.8);
  ctx.lineTo(-r, -r * 0.8);
  ctx.closePath();
  ctx.fillStyle = "#cfd6e0";
  ctx.fill();
  ctx.restore();
}

/* ----- HUD (plain text, INV6) -------------------------------------- */
function updateHud() {
  const s = state;
  const oxyPct = (s.oxygen / TUNING.OXYGEN_MAX_SECONDS) * 100;
  const pingElapsed = s.timeSec - s.ping.tStart;
  const pingStatus = (pingElapsed >= 0 && pingElapsed <= TUNING.PING_DURATION_SEC)
    ? "active (" + (TUNING.PING_DURATION_SEC - pingElapsed).toFixed(1) + "s left)"
    : "ready";
  const susp = suspicionState(s.suspicion);
  const instakillStr = (s.suspicion >= TUNING.SUSP_MAX && s.instakillTimer > 0)
    ? "   instakill in: " + Math.max(0, TUNING.INSTAKILL_SUSTAIN_SEC - s.instakillTimer).toFixed(2) + "s"
    : "";

  const reqDone = s.objectives.filter(o => o.captured).length;
  const reqTotal = s.objectives.length;
  const bonusStr = s.bonus.captured ? "yes" : "no";
  const allReq = reqDone === reqTotal;
  const distExtract = Math.hypot(s.sub.x - EXTRACTION.x, s.sub.y - EXTRACTION.y);
  const extractStatus = s.winState ? "EXTRACTED"
    : allReq ? ("ready -- head to EXTRACTION (" + distExtract.toFixed(0) + " px)")
    : ("need " + (reqTotal - reqDone) + " more required photo(s)");
  const aliveDrones = s.drones.filter(d => d.alive).length;
  const factoryGain = factoryProximityGainPerSec(s.sub.x, s.sub.y);
  const factoryStr = factoryGain > 0 ? ("+" + factoryGain + "/s") : "0";

  // Step 4 -- count visible Sirens (Sirens currently inside any reveal
  // window -- passive radius LOS-clear, ping LOS-clear, or any drone-cam
  // LOS-clear). Useful for testing; replaces vague "is anything near?".
  const sirensVisible = countVisibleSirens();
  const sirenGain = sirenProximityGainPerSec(s.sub.x, s.sub.y);
  const sirenGainStr = sirenGain > 0.001 ? ("+" + sirenGain.toFixed(2) + "/s") : "0";
  // Step 4 -- selected drone decoy mode for HUD.
  const sel = getSelectedDrone();
  const decoyStr = sel ? (sel.decoyMode ? "DECOY ON" : "decoy off") : "(no drone)";

  hud.textContent =
    "pos: (" + s.sub.x.toFixed(0) + ", " + s.sub.y.toFixed(0) + ")   " +
    "hull: " + s.hull + "/" + TUNING.HULL_MAX + "   " +
    "oxygen: " + oxyPct.toFixed(1) + "%   " +
    "ping: " + pingStatus + "   " +
    "t: " + s.timeSec.toFixed(1) + "s\n" +
    "suspicion: " + s.suspicion.toFixed(1) + "/100   " +
    "state: " + susp + instakillStr + "   " +
    "factory_prox: " + factoryStr + "   " +
    "siren_prox: " + sirenGainStr + "\n" +
    "drones: " + aliveDrones + " alive / " + s.droneSupply + " supply   " +
    "selected: " + (s.selectedDroneId != null ? ("d" + s.selectedDroneId) : "(none)") + " [" + decoyStr + "]   " +
    "photos: " + reqDone + "/" + reqTotal + " req, bonus: " + bonusStr + "\n" +
    "patroller: " + s.patroller.mode + "   sentinel: " + s.sentinel.mode + "   hunter: " + s.hunter.mode + "   " +
    "sirens_visible: " + sirensVisible + "   extraction: " + extractStatus;
}

// Step 4 -- helper used by HUD; counts Sirens whose body is LOS-clear from
// the sub OR any alive drone OR the active ping origin (matches the visual
// reveal model in drawSirenIfVisible).
function countVisibleSirens() {
  let n = 0;
  for (const sir of allSirens()) {
    const dxs = sir.x - state.sub.x, dys = sir.y - state.sub.y;
    if (dxs * dxs + dys * dys <= TUNING.PASSIVE_RADIUS_PX * TUNING.PASSIVE_RADIUS_PX
        && isLineOfSightClear(state.sub.x, state.sub.y, sir.x, sir.y)) { n++; continue; }
    let seen = false;
    for (const d of state.drones) {
      if (!d.alive) continue;
      const ddx = sir.x - d.x, ddy = sir.y - d.y;
      if (ddx * ddx + ddy * ddy <= TUNING.DRONE_VISION_RADIUS_PX * TUNING.DRONE_VISION_RADIUS_PX
          && isLineOfSightClear(d.x, d.y, sir.x, sir.y)) { seen = true; break; }
    }
    if (seen) { n++; continue; }
    const pingElapsed2 = state.timeSec - state.ping.tStart;
    if (pingElapsed2 >= 0 && pingElapsed2 <= TUNING.PING_DURATION_SEC) {
      const pingReachedRadius = TUNING.PING_RADIUS_PX * (pingElapsed2 / TUNING.PING_DURATION_SEC);
      const dpx = sir.x - state.ping.originX, dpy = sir.y - state.ping.originY;
      if (dpx * dpx + dpy * dpy <= pingReachedRadius * pingReachedRadius
          && isLineOfSightClear(state.ping.originX, state.ping.originY, sir.x, sir.y)) { n++; }
    }
  }
  return n;
}

/* ----- Main loop --------------------------------------------------- */
let lastT = performance.now();
function frame(nowMs) {
  const dt = Math.min(0.05, (nowMs - lastT) / 1000);
  lastT = nowMs;
  update(dt);
  render();
  updateHud();
  requestAnimationFrame(frame);
}

/* ----- Sim-test harness -------------------------------------------- *
 * Step 3 additions: FACTORY, OBJECTIVES, BONUS_OBJECTIVE, EXTRACTION,
 * factoryProximityGainPerSec, distancePointToRect, deployDrone,
 * redirectNearestDrone, cycleSelectedDrone, getSelectedDrone,
 * tryDronePhoto, trySubCamPhoto.
 *
 * Step 1 FIX-PASS 2026-06-04 additions (strict superset, no removals):
 *   applyInertia(dt, thrust, turn) -- runs the inertia step directly
 *     for headless tests (sub-stop-from-full-speed, sub-turn-from-rest)
 *   segmentRectIntersect(x1,y1,x2,y2,rect) -- raw raycast primitive
 *   isLineOfSightClear(x1,y1,x2,y2) -- terrain+factory LOS predicate
 *   raycastTerrainHit(x1,y1,x2,y2) -- first occluder along segment
 *
 * Step 1+2+3 surface preserved verbatim.
 * ------------------------------------------------------------------- */
window.__sim = {
  TUNING,
  TERRAIN,
  PATROL_ROUTE,
  FACTORY,
  OBJECTIVES,
  BONUS_OBJECTIVE,
  EXTRACTION,
  newState,
  update,
  setState: (s) => { state = s; },
  getState: () => state,
  tryActivePing,
  circleRectOverlap,
  applySuspicion,
  suspicionState,
  isAlertPlus,
  updatePatroller,
  nearestWaypointIdx,
  factoryProximityGainPerSec,
  distancePointToRect,
  deployDrone,
  redirectNearestDrone,
  cycleSelectedDrone,
  getSelectedDrone,
  tryDronePhoto,
  trySubCamPhoto,
  // Step 1 fix-pass 2026-06-04 additions:
  applyInertia,
  segmentRectIntersect,
  isLineOfSightClear,
  raycastTerrainHit,
  // Step 4 additions (Sentinel/Hunter/curiosity/decoy/siren-proximity):
  allSirens,
  sirenProximityGainPerSec,
  sirenProxTerm,
  findCuriosityTarget,
  moveToward,
  toggleDecoyOnSelected,
  updateSentinel,
  updateHunter,
  updatePatrollerWithCuriosity,
  countVisibleSirens,
  // Accessors for the new Sirens (convenience for tests):
  getSentinel: () => state.sentinel,
  getHunter:   () => state.hunter,
  getPatroller: () => state.patroller,
};

state = newState();
requestAnimationFrame(frame);
</script>
