                                        // FLAG step 7. Loose enough to be
                                        // achievable; close enough to feel
                                        // like "close-range" per spec section 8.

  // step 3 -- sub fallback camera (spec section 2 / 8)
  SUBCAM_PHOTO_RANGE_PX: 70,            // sub must close to point-blank for
                                        // any objective -- silhouette is the
                                        // exception (range below).
                                        // FLAG step 7 -- "your call" per brief.
  SUBCAM_SILHOUETTE_RANGE_PX: 320,      // silhouette comfortably sub-cammable
                                        // from distance (spec section 8).
                                        // FLAG step 7.

  // step 3 -- factory proximity (spec section 6)
  // "+1 to +3/sec, scales with closeness"
  FACTORY_PROX_NEAR_PX: 140,            // <= NEAR -> +3/s
  FACTORY_PROX_MID_PX:  260,            // <= MID  -> +2/s; <= FAR -> +1/s
  FACTORY_PROX_FAR_PX:  420,
  FACTORY_PROX_NEAR_RATE: 3,
  FACTORY_PROX_MID_RATE:  2,
  FACTORY_PROX_FAR_RATE:  1,

