                                       // no thrust (velocity *= (1 - drag*dt)
                                       // each tick; ~0.45/s => coast ~3s)
  SUB_TURN_ACCEL_RAD_PER_SEC2:  2.6,   // FLAG step 7 -- angular accel on turn input
  SUB_TURN_DRAG_PER_SEC:        2.0,   // FLAG step 7 -- angular decay when no turn
